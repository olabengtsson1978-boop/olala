{
  "manifest_version": 3,
  "name": "Stash – spara idéer du hittar",
  "version": "0.1.0",
  "description": "Markera text på valfri sida, spara den som ett kort, bläddra i ditt bibliotek och repetera dina bästa fynd senare.",
  "permissions": ["contextMenus", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stash",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
